<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/athena_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- BARRA SUPERIOR / ENCABEZADO DE NAVEGACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/athena_sidebar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Logo del zorrito ATHENA"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_zorrito" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="ATHENA"
                android:textColor="@color/athena_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♟"
                    android:textColor="@color/athena_text"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_notification_badge"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/athena_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </LinearLayout>

        <!-- CONTENIDO PRINCIPAL EN VERTICAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- TÍTULO Y BOTÓN DE ANÁLISIS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estadísticas y Progreso"
                android:textColor="@color/athena_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Analiza tu rendimiento y sigue mejorando cada día."
                android:textColor="@color/athena_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnAnalisis"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_athena_orange"
                android:gravity="center"
                android:text="▤   Ver Análisis Profundo"
                android:textColor="#32251A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- TARJETA 1: PUNTAJE ESTIMADO ACTUAL (ANCHO COMPLETO) -->
            <LinearLayout
                style="@style/CardAthena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/LabelAthena"
                    android:text="PUNTAJE ESTIMADO ACTUAL"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="340"
                    android:textColor="@color/athena_text"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <!-- BADGES NIVEL ALTO Y PERCENTIL 78% -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_athena_badge"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="Nivel Alto"
                        android:textColor="@color/athena_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_athena_badge"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="Percentil 78%"
                        android:textColor="@color/athena_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="+25 puntos este mes"
                    android:textColor="@color/athena_muted"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Excelente trabajo, vas por buen camino."
                    android:textColor="@color/athena_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- TARJETAS 2 Y 3 (FILA DE 2 COLUMNAS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/LabelAthena"
                        android:gravity="center"
                        android:text="SIMULACROS COMPLETADOS" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="12"
                        android:textColor="@color/athena_text"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Último hace 2 días"
                        android:textColor="@color/athena_muted"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="+3 simulacros este mes"
                        android:textColor="@color/athena_text"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/LabelAthena"
                        android:gravity="center"
                        android:text="ÁREA MÁS FUERTE" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="Lectura Crítica"
                        android:textColor="@color/athena_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Percentil 85%"
                        android:textColor="@color/athena_muted"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Sigue así!"
                        android:textColor="@color/athena_text"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- GRÁFICA DE EVOLUCIÓN (APILADA) -->
            <LinearLayout
                style="@style/CardAthena"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/TitleAthena"
                    android:text="Evolución del Puntaje Global"
                    android:textSize="13sp" />

                <FrameLayout
                    android:id="@+id/chartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+65 puntos"
                        android:textColor="@color/athena_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meta mensual 340 / 400"
                        android:textColor="@color/athena_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- DESEMPEÑO POR ÁREAS (%) (APILADO) -->
            <LinearLayout
                style="@style/CardAthena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/TitleAthena"
                    android:text="Desempeño por Áreas (%)"
                    android:textSize="13sp" />

                <!-- LECTURA -->
                <LinearLayout
                    style="@style/AreaRowAthena"
                    android:layout_marginTop="10dp">

                    <TextView
                        style="@style/AreaNameAthena"
                        android:text="Lectura" />

                    <FrameLayout style="@style/TrackAthena">

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:padding="0dp"
                            android:progress="85"
                            android:progressBackgroundTint="#10192D"
                            android:progressTint="@color/athena_purple" />

                        <TextView
                            style="@style/BarValueAthena"
                            android:text="85%" />
                    </FrameLayout>
                </LinearLayout>

                <!-- MATEMÁTICAS -->
                <LinearLayout style="@style/AreaRowAthena">

                    <TextView
                        style="@style/AreaNameAthena"
                        android:text="Matemáticas" />

                    <FrameLayout style="@style/TrackAthena">

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:padding="0dp"
                            android:progress="75"
                            android:progressBackgroundTint="#10192D"
                            android:progressTint="@color/athena_blue" />

                        <TextView
                            style="@style/BarValueAthena"
                            android:text="75%" />
                    </FrameLayout>
                </LinearLayout>

                <!-- CIENCIAS -->
                <LinearLayout style="@style/AreaRowAthena">

                    <TextView
                        style="@style/AreaNameAthena"
                        android:text="Ciencias" />

                    <FrameLayout style="@style/TrackAthena">

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:padding="0dp"
                            android:progress="60"
                            android:progressBackgroundTint="#10192D"
                            android:progressTint="@color/athena_orange" />

                        <TextView
                            style="@style/BarValueAthena"
                            android:text="60%" />
                    </FrameLayout>
                </LinearLayout>

                <!-- SOCIALES -->
                <LinearLayout style="@style/AreaRowAthena">

                    <TextView
                        style="@style/AreaNameAthena"
                        android:text="Sociales" />

                    <FrameLayout style="@style/TrackAthena">

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:padding="0dp"
                            android:progress="70"
                            android:progressBackgroundTint="#10192D"
                            android:progressTint="@color/athena_green" />

                        <TextView
                            style="@style/BarValueAthena"
                            android:text="70%" />
                    </FrameLayout>
                </LinearLayout>

                <!-- INGLÉS -->
                <LinearLayout style="@style/AreaRowAthena">

                    <TextView
                        style="@style/AreaNameAthena"
                        android:text="Inglés" />

                    <FrameLayout style="@style/TrackAthena">

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:padding="0dp"
                            android:progress="30"
                            android:progressBackgroundTint="#10192D"
                            android:progressTint="@color/athena_red" />

                        <TextView
                            style="@style/BarValueAthena"
                            android:text="30%" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- RECOMENDACIÓN ATHENA (ANCHO COMPLETO) -->
            <LinearLayout
                style="@style/CardAthena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/TitleAthena"
                    android:text="Recomendación ATHENA"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Inglés es tu área con mayor oportunidad de mejora."
                    android:textColor="@color/athena_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnPracticarIngles"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_athena_blue"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="✥   Practicar Inglés"
                    android:textColor="@color/athena_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TRES TARJETAS INFERIORES EN FILA DE 3 COLUMNAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        style="@style/LabelAthena"
                        android:gravity="center"
                        android:text="Racha actual" />

                    <TextView
                        style="@style/MetricAthena"
                        android:layout_marginTop="2dp"
                        android:text="12 días"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        style="@style/LabelAthena"
                        android:gravity="center"
                        android:text="Mejora semanal" />

                    <TextView
                        style="@style/MetricAthena"
                        android:layout_marginTop="2dp"
                        android:text="+15 pts"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        style="@style/LabelAthena"
                        android:gravity="center"
                        android:text="Puntaje más alto" />

                    <TextView
                        style="@style/MetricAthena"
                        android:layout_marginTop="2dp"
                        android:text="340"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- PIE DE PÁGINA (CENTRADO Y APILADO PARA MÓVIL VERTICAL) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="© 2026 Proyecto ATHENA - Análisis y Desarrollo de Software"
                    android:textColor="@color/athena_muted"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="SENA - Centro de Comercio y Servicios"
                    android:textColor="@color/athena_muted"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>