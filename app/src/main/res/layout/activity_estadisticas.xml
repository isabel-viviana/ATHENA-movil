<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/athena_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- MENU LATERAL -->
        <LinearLayout
            android:layout_width="142dp"
            android:layout_height="match_parent"
            android:background="@color/athena_sidebar"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/logo_zorrito"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logo del zorrito ATHENA" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="ATHENA"
                    android:textColor="@color/athena_text"
                    android:textStyle="bold"
                    android:textSize="14sp" />

            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <TextView
                style="@style/MenuAthena"
                android:text="⌂   Inicio" />

            <TextView
                style="@style/MenuAthena"
                android:text="▣   Simulacros" />

            <TextView
                style="@style/MenuAthena"
                android:text="✥   Prácticas" />

            <TextView
                style="@style/MenuAthena"
                android:text="♟   Tutor IA" />

            <TextView
                style="@style/MenuAthenaSelected"
                android:text="◉   Estadísticas" />

            <TextView
                style="@style/MenuAthena"
                android:text="🏆   Ranking" />

            <TextView
                style="@style/MenuAthena"
                android:text="⊙   Perfil" />

            <View
                android:layout_width="match_parent"
                android:layout_height="18dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/athena_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/MenuAthena"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="♟   Notificaciones" />

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_notification_badge"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/athena_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- CONTENIDO PRINCIPAL -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <!-- ENCABEZADO Y BOTÓN DE ANÁLISIS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estadísticas y Progreso"
                    android:textColor="@color/athena_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Analiza tu rendimiento y sigue mejorando cada día."
                    android:textColor="@color/athena_muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnAnalisis"
                    android:layout_width="320dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_athena_orange"
                    android:gravity="center"
                    android:text="▤   Ver Análisis Profundo"
                    android:textColor="#32251A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TARJETAS SUPERIORES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.4"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LabelAthena"
                        android:text="PUNTAJE ESTIMADO ACTUAL" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="340"
                        android:textColor="@color/athena_text"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <!-- BADGES / PILLS DE NIVEL Y PERCENTIL -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_athena_badge"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="Nivel Alto"
                            android:textColor="@color/athena_text"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_athena_badge"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="Percentil 78%"
                            android:textColor="@color/athena_text"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="+25 puntos este mes"
                        android:textColor="@color/athena_muted"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Excelente trabajo, vas por buen camino."
                        android:textColor="@color/athena_muted"
                        android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LabelAthena"
                        android:text="SIMULACROS COMPLETADOS" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textColor="@color/athena_text"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Último hace 2 días"
                        android:textColor="@color/athena_muted"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="+3 simulacros este mes"
                        android:textColor="@color/athena_text"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LabelAthena"
                        android:text="ÁREA MÁS FUERTE" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Lectura Crítica"
                        android:textColor="@color/athena_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Percentil 85%"
                        android:textColor="@color/athena_muted"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Sigue así!"
                        android:textColor="@color/athena_text"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- GRÁFICAS CENTRALES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- EVOLUCIÓN -->
                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/TitleAthena"
                        android:text="Evolución del Puntaje Global" />

                    <FrameLayout
                        android:id="@+id/chartContainer"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="+65 puntos"
                            android:textColor="@color/athena_text"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meta mensual 340 / 400"
                            android:textColor="@color/athena_muted"
                            android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- DESEMPEÑO POR ÁREAS (%) -->
                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/TitleAthena"
                        android:text="Desempeño por Áreas (%)" />

                    <!-- LECTURA -->
                    <LinearLayout
                        style="@style/AreaRowAthena"
                        android:layout_marginTop="8dp">

                        <TextView
                            style="@style/AreaNameAthena"
                            android:text="Lectura" />

                        <FrameLayout style="@style/TrackAthena">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminate="false"
                                android:max="100"
                                android:padding="0dp"
                                android:progress="85"
                                android:progressBackgroundTint="#10192D"
                                android:progressTint="@color/athena_purple" />

                            <TextView
                                style="@style/BarValueAthena"
                                android:text="85%" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- MATEMÁTICAS -->
                    <LinearLayout style="@style/AreaRowAthena">

                        <TextView
                            style="@style/AreaNameAthena"
                            android:text="Matemáticas" />

                        <FrameLayout style="@style/TrackAthena">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminate="false"
                                android:max="100"
                                android:padding="0dp"
                                android:progress="75"
                                android:progressBackgroundTint="#10192D"
                                android:progressTint="@color/athena_blue" />

                            <TextView
                                style="@style/BarValueAthena"
                                android:text="75%" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- CIENCIAS -->
                    <LinearLayout style="@style/AreaRowAthena">

                        <TextView
                            style="@style/AreaNameAthena"
                            android:text="Ciencias" />

                        <FrameLayout style="@style/TrackAthena">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminate="false"
                                android:max="100"
                                android:padding="0dp"
                                android:progress="60"
                                android:progressBackgroundTint="#10192D"
                                android:progressTint="@color/athena_orange" />

                            <TextView
                                style="@style/BarValueAthena"
                                android:text="60%" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- SOCIALES -->
                    <LinearLayout style="@style/AreaRowAthena">

                        <TextView
                            style="@style/AreaNameAthena"
                            android:text="Sociales" />

                        <FrameLayout style="@style/TrackAthena">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminate="false"
                                android:max="100"
                                android:padding="0dp"
                                android:progress="70"
                                android:progressBackgroundTint="#10192D"
                                android:progressTint="@color/athena_green" />

                            <TextView
                                style="@style/BarValueAthena"
                                android:text="70%" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- INGLÉS -->
                    <LinearLayout style="@style/AreaRowAthena">

                        <TextView
                            style="@style/AreaNameAthena"
                            android:text="Inglés" />

                        <FrameLayout style="@style/TrackAthena">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminate="false"
                                android:max="100"
                                android:padding="0dp"
                                android:progress="30"
                                android:progressBackgroundTint="#10192D"
                                android:progressTint="@color/athena_red" />

                            <TextView
                                style="@style/BarValueAthena"
                                android:text="30%" />
                        </FrameLayout>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- RECOMENDACIÓN Y TARJETAS INFERIORES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.6"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/TitleAthena"
                        android:text="Recomendación ATHENA" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Inglés es tu área con mayor oportunidad de mejora."
                        android:textColor="@color/athena_muted"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/btnPracticarIngles"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_athena_blue"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="✥  Practicar Inglés"
                        android:textColor="@color/athena_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="0.55"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LabelAthena"
                        android:text="Racha actual" />

                    <TextView
                        style="@style/MetricAthena"
                        android:text="12 días" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="0.55"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LabelAthena"
                        android:text="Mejora semanal" />

                    <TextView
                        style="@style/MetricAthena"
                        android:text="+15 pts" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardAthena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="0.55"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LabelAthena"
                        android:text="Puntaje más alto" />

                    <TextView
                        style="@style/MetricAthena"
                        android:text="340" />
                </LinearLayout>
            </LinearLayout>

            <!-- PIE DE PÁGINA (ALINEADO A LA IZQUIERDA Y DERECHA) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="© 2026 Proyecto ATHENA - Análisis y Desarrollo de Software"
                    android:textColor="@color/athena_muted"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SENA - Centro de Comercio y Servicios"
                    android:textColor="@color/athena_muted"
                    android:textSize="8sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>